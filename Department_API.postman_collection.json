            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Marketing\",\n  \"code\": \"MKT\",\n  \"description\": \"Marketing, branding, and customer outreach\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/departments",
          "host": ["{{baseUrl}}"],
          "path": ["departments"]
        }
      },
      "response": []
    },
    {
      "name": "Example: Create Operations Dept",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Operations\",\n  \"code\": \"OPS\",\n  \"description\": \"Business operations and process management\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/departments",
          "host": ["{{baseUrl}}"],
          "path": ["departments"]
        }
      },
      "response": []
    },
    {
      "name": "Example: Create HR Dept",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Human Resources\",\n  \"code\": \"HR\",\n  \"description\": \"Employee management, recruitment, and HR policies\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/departments",
          "host": ["{{baseUrl}}"],
          "path": ["departments"]
        }
      },
      "response": []
    }
  ]
}
